#!/usr/bin/env python3
"""Persist agent-to-pane metadata in tmux-resurrect snapshots."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
from pathlib import Path

RECORD_PREFIX = "agent_context\t"
TMUX_FORMAT = "\t".join(  # noqa: FLY002
    [
        "#{session_name}",
        "#{window_index}",
        "#{pane_index}",
        "#{pane_id}",
        "#{pane_current_path}",
        "#{@agent_kind}",
        "#{@agent_title}",
        "#{@agent_request}",
        "#{@agent_thread_id}",
        "#{@agent_cwd}",
        "#{@agent_updated_utc}",
    ]
)
OPTION_FIELDS = {
    "agent": "@agent_kind",
    "title": "@agent_title",
    "request": "@agent_request",
    "thread_id": "@agent_thread_id",
    "cwd": "@agent_cwd",
    "updated_utc": "@agent_updated_utc",
}


def tmux_output(*args: str) -> str:
    return subprocess.check_output(
        ["tmux", *args], stderr=subprocess.DEVNULL, text=True
    ).strip()


def default_snapshot() -> Path:
    configured_dir = tmux_output("show-option", "-gqv", "@resurrect-dir")
    if configured_dir:
        resurrect_dir = Path(os.path.expandvars(os.path.expanduser(configured_dir)))
    else:
        data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
        resurrect_dir = data_home / "tmux/resurrect"
    return resurrect_dir / "last"


def read_contexts(snapshot: Path) -> list[dict[str, str]]:
    contexts = []
    with snapshot.open(encoding="utf-8") as stream:
        for line in stream:
            if not line.startswith(RECORD_PREFIX):
                continue
            try:
                context = json.loads(line[len(RECORD_PREFIX) :])
            except json.JSONDecodeError:
                continue
            if isinstance(context, dict):
                contexts.append({str(key): str(value) for key, value in context.items()})
    return contexts


def capture_contexts() -> list[dict[str, str]]:
    output = tmux_output("list-panes", "-a", "-F", TMUX_FORMAT)
    contexts = []
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) != 11:
            continue
        (
            session,
            window,
            pane,
            pane_id,
            current_cwd,
            agent,
            title,
            request,
            thread_id,
            agent_cwd,
            updated_utc,
        ) = fields
        if not any((title, request, thread_id)):
            continue
        contexts.append(
            {
                "session": session,
                "window": window,
                "pane": pane,
                "pane_id": pane_id,
                "agent": agent,
                "title": title,
                "request": request,
                "thread_id": thread_id,
                "cwd": agent_cwd or current_cwd,
                "updated_utc": updated_utc,
            }
        )
    return contexts


def append_snapshot(snapshot: Path) -> None:
    contexts = capture_contexts()
    if not contexts:
        return
    with snapshot.open("a", encoding="utf-8") as stream:
        for context in contexts:
            payload = json.dumps(context, ensure_ascii=True, sort_keys=True)
            stream.write(f"{RECORD_PREFIX}{payload}\n")


def restore_snapshot(snapshot: Path) -> None:
    for context in read_contexts(snapshot):
        target = f"{context['session']}:{context['window']}.{context['pane']}"
        for field, option in OPTION_FIELDS.items():
            value = context.get(field, "")
            subprocess.run(
                ["tmux", "set-option", "-p", "-t", target, option, value],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )


def list_snapshot(snapshot: Path) -> None:
    for context in read_contexts(snapshot):
        location = (
            f"{context.get('session', '?')}:"
            f"{context.get('window', '?')}.{context.get('pane', '?')}"
        )
        columns = [
            location,
            context.get("agent", ""),
            context.get("title", ""),
            context.get("thread_id", ""),
            context.get("cwd", ""),
        ]
        print("\t".join(columns))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "action", choices=("append-snapshot", "restore", "list")
    )
    parser.add_argument("snapshot", nargs="?", type=Path)
    args = parser.parse_args()

    snapshot = args.snapshot or default_snapshot()
    if args.action == "append-snapshot":
        append_snapshot(snapshot)
    elif args.action == "restore":
        restore_snapshot(snapshot)
    else:
        list_snapshot(snapshot)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
