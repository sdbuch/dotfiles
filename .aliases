# some more ls aliases
alias ll='ls -FhlasG'
alias la='ls -A'
alias l='ls -CF'
alias lt='ls -FhlasGrt'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
# alias ls='ls -G'

# latex
alias cp-sam-macros='cp "$HOME/dotfiles/sam_macros.def" . && cp "$HOME/dotfiles/sam_macros_nofontspec.def" . && cp "$HOME/dotfiles/sam_macros_common.def" .'

# tmux
# NOTE: these are redundant with oh-my-zsh
alias ta='tmux attach-session -t'
alias tk='tmux kill-session -t'
alias tl='tmux ls'

# nvim vs. vim
alias vim='nvim'

# uv
alias uvim='uv run nvim'
alias upyterm='uv run ipython --profile=term'
# uinit - Initialize a uv project with common dependencies and ruff configuration
uinit() {
    echo "🚀 Initializing uv project..."
    uv init --bare

    echo "📦 Adding dependencies..."
    uv add \
        jax \
        matplotlib \
        treescope \
        matplotlib-backend-sixel \
        pynvim \
        jupyter_client \
        ipykernel \
        requests \
        websocket-client

    echo "🔧 Adding ruff configuration to pyproject.toml..."
    cat >> pyproject.toml << 'EOF'

[tool.ruff]
line-length = 88
indent-width = 2

[tool.ruff.format]
indent-style = "space"

[tool.ruff.lint]
fixable = ["ALL"]
unfixable = []

select = ["E", "W", "F"]  # Error, Warning, and Pyflakes rules

ignore = [
    "F401",  # Unused import
    "F821",  # Undefined name
    "E402",  # Module level import not at top of file
    "F841",  # Local variable assigned but not used
    "E731",  # use a def, not a lambda
]
EOF
}

alias action='source .venv/bin/activate'
alias glogin='gcloud auth login --update-adc'

# Run command and copy both command + output to clipboard
cprun() {
    local cmd
    cmd=$(printf '%q ' "$@")
    { echo "$ $*"; eval "$cmd" 2>&1; } | tee /dev/tty | pbcopy
}

# Optional machine-specific or private aliases.
if [ -r "$HOME/.aliases_local" ]; then
    . "$HOME/.aliases_local"
fi
